// SPDX-License-Identifier: Apache-2.0
import "../src/http.noqeri"

function require(ok: bool): void {
    if !ok { let invalid: *u8 = 0 as *u8 print(invalid[0]) }
}

function test_http(): int {
    require(httpIsSuccess(200))
    require(httpIsRedirect(303))
    require(httpIsClientError(404))
    require(httpIsServerError(503))
    require(httpRequestMethodValid("POST"))
    require(!httpResponseBodyAllowed(204))

    // "GET /api/id?p=7 HTTP/1.1\r\nHost: x\r\n\r\n" (37 bytes)
    let raw: [u8; 37]
    raw[0] = 71 as u8 raw[1] = 69 as u8 raw[2] = 84 as u8 raw[3] = 32 as u8 // "GET "
    raw[4] = 47 as u8 raw[5] = 97 as u8 raw[6] = 112 as u8 raw[7] = 105 as u8 // "/api"
    raw[8] = 47 as u8 raw[9] = 105 as u8 raw[10] = 100 as u8 // "/id"
    raw[11] = 63 as u8 raw[12] = 112 as u8 raw[13] = 61 as u8 raw[14] = 55 as u8 raw[15] = 32 as u8 // "?p=7 "
    raw[16] = 72 as u8 raw[17] = 84 as u8 raw[18] = 84 as u8 raw[19] = 80 as u8 raw[20] = 47 as u8 raw[21] = 49 as u8 raw[22] = 46 as u8 raw[23] = 49 as u8
    raw[24] = 13 as u8 raw[25] = 10 as u8
    raw[26] = 72 as u8 raw[27] = 111 as u8 raw[28] = 115 as u8 raw[29] = 116 as u8 raw[30] = 58 as u8 raw[31] = 32 as u8 raw[32] = 120 as u8
    raw[33] = 13 as u8 raw[34] = 10 as u8 raw[35] = 13 as u8 raw[36] = 10 as u8

    let req: HttpParsedRequest
    require(httpParseRequest(slice(&raw[0 as usize], 37 as usize), &req))
    require(req.valid && req.methodCode == 1 && req.pathLen == 7 as usize && req.queryLen == 3 as usize && req.headerCount == 1 as usize)

    let pat: [u8; 8]
    pat[0] = 47 as u8 pat[1] = 97 as u8 pat[2] = 112 as u8 pat[3] = 105 as u8 pat[4] = 47 as u8 pat[5] = 58 as u8 pat[6] = 105 as u8 pat[7] = 100 as u8
    let pth: [u8; 7]
    pth[0] = 47 as u8 pth[1] = 97 as u8 pth[2] = 112 as u8 pth[3] = 105 as u8 pth[4] = 47 as u8 pth[5] = 52 as u8 pth[6] = 50 as u8
    require(httpRouteMatch(slice(&pat[0 as usize], 8 as usize), slice(&pth[0 as usize], 7 as usize)))

    let q: [u8; 3]
    q[0] = 112 as u8 q[1] = 61 as u8 q[2] = 55 as u8
    let qk: [u8; 1]
    qk[0] = 112 as u8
    let qs: usize = 0 as usize
    let ql: usize = 0 as usize
    require(httpFindQueryParam(slice(&q[0 as usize], 3 as usize), slice(&qk[0 as usize], 1 as usize), &qs, &ql))
    require(qs == 2 as usize && ql == 1 as usize)

    let outLine: [u8; 20]
    require(httpFormatStatusLine(201, slice(&outLine[0 as usize], 20 as usize)) == 14 as usize)
    require(outLine[9] == 50 as u8 && outLine[11] == 49 as u8)
    return 1
}

require(test_http() == 1)
print("noqeri-http package tests: OK")
